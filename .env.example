# --- Supabase del portal ------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Alertas de emergencia de Aluna --------------------------------------------
# Aluna (el sistema de jornada y emergencias del campus) difunde sismo,
# incendio y seguridad a los teléfonos que se suscriben.
#
# VITE_ALUNA_ALERTAS_URL: la Edge Function `api-alertas` de Aluna, completa:
#   https://<PROYECTO-DE-ALUNA>.supabase.co/functions/v1/api-alertas
#
# VITE_ALUNA_VAPID_KEY: la MISMA clave VAPID pública con la que Aluna firma
# sus push (allí se llama VITE_VAPID_PUBLIC_KEY). El par VAPID identifica al
# emisor, no a la aplicación: por eso un solo par sirve a todas las apps
# institucionales.
VITE_ALUNA_ALERTAS_URL=
VITE_ALUNA_VAPID_KEY=
